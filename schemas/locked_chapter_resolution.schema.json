{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LockedChapterResolution",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "book_id",
    "chapter_index",
    "action",
    "source_run_id",
    "resolved_execution_ids",
    "resolved_attempt_ids",
    "discarded_run_ids",
    "expected_scene_count",
    "complete_draft",
    "scenes",
    "reason",
    "resolution_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1", "1.2"]},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 1},
    "chapter_index": {"type": "integer", "minimum": 1},
    "action": {
      "type": "string",
      "enum": ["repair_draft", "resume_scenes", "reset"]
    },
    "source_run_id": {"type": "string", "minLength": 1},
    "resolved_execution_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resolved_attempt_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "discarded_run_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "expected_scene_count": {"type": "integer", "minimum": 1},
    "complete_draft": {
      "type": ["object", "null"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64},
        "problem_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_stage": {
          "type": "string",
          "enum": ["chapter", "chapter_generation", "claude_polish", "scene_repair"]
        },
        "source_attempt_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "text", "sha256", "source_attempt_id"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64},
          "source_attempt_id": {"type": "string", "minLength": 1},
          "source_provenance": {
            "type": "object",
            "required": [
              "source_run_id",
              "execution_id",
              "call_id",
              "attempt_id",
              "receipt_hash",
              "response_artifact_hash"
            ],
            "properties": {
              "source_run_id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
              "source_run_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
              "execution_id": {"type": "string", "minLength": 10, "maxLength": 192, "pattern": "^execution_[A-Za-z0-9._-]{0,182}$"},
              "call_id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
              "attempt_id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
              "receipt_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
              "response_artifact_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["event_id", "type", "subjects", "objects", "location", "status"],
              "properties": {
                "event_id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "subjects": {"type": "array", "items": {"type": "string"}},
                "objects": {"type": "array", "items": {"type": "string"}},
                "location": {"type": "string"},
                "status": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "deltas": {
            "type": "object",
            "required": [
              "characters",
              "relationships",
              "rosters",
              "locations",
              "inventory",
              "counters"
            ],
            "properties": {
              "characters": {"type": "array", "items": {"type": "object"}},
              "relationships": {"type": "array", "items": {"type": "object"}},
              "rosters": {"type": "array", "items": {"type": "object"}},
              "locations": {"type": "array", "items": {"type": "object"}},
              "inventory": {"type": "array", "items": {"type": "object"}},
              "counters": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": false
          },
          "continuity_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "resolution_hash": {"type": "string", "minLength": 64}
  },
  "additionalProperties": false
}
