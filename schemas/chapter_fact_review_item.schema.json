{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterFactReviewItem",
  "type": "object",
  "required": [
    "fact_id",
    "local_key",
    "kind",
    "summary",
    "evidence_spans",
    "proposal",
    "review"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "pattern": "^fact_[0-9a-f]{32}$"
    },
    "local_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "event",
        "character_state",
        "relationship",
        "roster",
        "location",
        "inventory",
        "counter"
      ]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "quote"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "quote": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "proposal": {"type": "object"},
    "review": {
      "type": "object",
      "required": ["origin", "decision", "author_edited", "reason"],
      "properties": {
        "origin": {"type": "string", "enum": ["model", "author"]},
        "decision": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"]
        },
        "author_edited": {"type": "boolean"},
        "reason": {"type": ["string", "null"], "maxLength": 500}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
