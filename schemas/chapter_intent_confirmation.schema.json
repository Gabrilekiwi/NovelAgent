{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterIntentConfirmation",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "book_id",
    "chapter_index",
    "confirmed",
    "card_sha256",
    "context_sha256",
    "chapter_intent",
    "confirmation_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "record_type": {"type": "string", "enum": ["chapter_intent_confirmation"]},
    "book_id": {"type": "string", "minLength": 1},
    "chapter_index": {"type": "integer", "minimum": 1},
    "confirmed": {"type": "boolean", "enum": [true]},
    "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_intent": {
      "type": "object",
      "required": ["goal", "validation_focus", "notes"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "validation_focus": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["continuity", "spatial", "logic"]}
        },
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "confirmation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
