{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeEvidence",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "authority",
    "execution_cutover",
    "run_id",
    "created_at",
    "workflow_snapshot",
    "context_manifest",
    "attempts",
    "checkpoints",
    "recovery",
    "usage",
    "artifact_ref",
    "evidence_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "mode": {"type": "string", "enum": ["shadow"]},
    "authority": {"type": "string", "enum": ["legacy_executor"]},
    "execution_cutover": {"type": "boolean", "enum": [false]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "created_at": {"type": "string", "minLength": 1},
    "workflow_snapshot": {
      "type": "object",
      "required": ["schema_version", "workflow_digest", "nodes"],
      "properties": {
        "schema_version": {"type": "string", "enum": ["1.0"]},
        "workflow_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "index", "action", "requires", "produces", "mode", "skippable", "failure_policy", "contract_digest"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z][a-z0-9_]*$"},
              "index": {"type": "integer", "minimum": 1},
              "action": {
                "type": "string",
                "enum": ["build_snapshot", "pre_validate_bridge", "generate_chapter", "polish", "validate", "repair_if_needed", "commit_snapshot"]
              },
              "requires": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "produces": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "mode": {"type": "string", "enum": ["required", "optional", "conditional"]},
              "skippable": {"type": "boolean"},
              "failure_policy": {"type": "string", "enum": ["fail_run", "continue_unpolished"]},
              "contract_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "context_manifest": {
      "type": "object",
      "required": ["entries", "manifest_digest"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["logical_ref", "direction", "content_type", "sha256", "chars", "estimated_tokens", "token_estimate_method"],
            "properties": {
              "logical_ref": {"type": "string", "enum": ["snapshot", "input_pack", "workflow_plan", "chapter", "validation", "analysis"]},
              "direction": {"type": "string", "enum": ["input", "output"]},
              "content_type": {"type": "string", "enum": ["text/plain", "application/json"]},
              "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
              "chars": {"type": "integer", "minimum": 0},
              "estimated_tokens": {"type": "integer", "minimum": 0},
              "token_estimate_method": {"type": "string", "enum": ["utf8_bytes_upper_bound"]}
            },
            "additionalProperties": false
          }
        },
        "manifest_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_id", "node_id", "ordinal", "trace_index", "status", "started_at", "finished_at", "duration_ms", "implicit", "skipped", "trace_digest"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1, "maxLength": 320},
          "node_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "ordinal": {"type": "integer", "minimum": 1},
          "trace_index": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["completed", "failed"]},
          "started_at": {"type": "string", "minLength": 1},
          "finished_at": {"type": "string", "minLength": 1},
          "duration_ms": {"type": "integer", "minimum": 0},
          "implicit": {"type": "boolean"},
          "skipped": {"type": "boolean"},
          "trace_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "attempt_id", "node_id", "status", "trace_digest", "resume_capable"],
        "properties": {
          "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 350},
          "attempt_id": {"type": "string", "minLength": 1, "maxLength": 320},
          "node_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "status": {"type": "string", "enum": ["observed_completed", "observed_failed"]},
          "trace_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
          "resume_capable": {"type": "boolean", "enum": [false]}
        },
        "additionalProperties": false
      }
    },
    "recovery": {
      "type": "object",
      "required": ["decision", "resume_node_id", "reason", "authoritative"],
      "properties": {
        "decision": {"type": "string", "enum": ["not_needed", "legacy_executor_required"]},
        "resume_node_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "authoritative": {"type": "boolean", "enum": [false]}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "source", "receipt_hashes", "call_count", "input_tokens", "output_tokens", "total_tokens", "complete"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "source": {"type": "string", "enum": ["model_call_receipts"]},
          "receipt_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
          },
          "call_count": {"type": "integer", "minimum": 1},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "total_tokens": {"type": ["integer", "null"], "minimum": 0},
          "complete": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "artifact_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "evidence_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
